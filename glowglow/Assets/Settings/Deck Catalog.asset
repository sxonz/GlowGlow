    weapon: {fileID: 11400000, guid: e7a01bda95444dcb8b10e1ba0e435226, type: 2}
    description: "\uCD5C\uB300 5\uCD08\uAC04 \uC774\uB3D9 \uC18D\uB3C4 150%\uC640
