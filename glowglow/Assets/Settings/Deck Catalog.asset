%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e81dc1ba463948b78c45fd25271c1661, type: 3}
  m_Name: Deck Catalog
  m_EditorClassIdentifier: 
  cards:
  - id: pulse-shot
    weapon: {fileID: 11400000, guid: 1220a3891f7ecd1449a9c7f6650162d8, type: 2}
    description: "\uC791\uC740 \uAD6C\uCCB4\uB97C \uCD1D\uAD6C\uC5D0\uC11C \uBC1C\uC0AC\uD569\uB2C8\uB2E4.
      \uAE30\uBCF8 \uD0C4\uC18D 11, \uBC1C\uC0AC \uAC04\uACA9 0.26\uCD08."
  - id: basic-barrage-02
    weapon: {fileID: 11400000, guid: 1ca4afb87a554be2870c173d6bfe85dc, type: 2}
    description: "짧은 예고 이후 레이저를 발사합니다. 쿨타임 2초."
  - id: basic-barrage-03
    weapon: {fileID: 11400000, guid: 3bf8005000c04658bf13bd9b2c00737a, type: 2}
    description: "총 5발의 탄환을 흩뿌립니다., 쿨타임 2초."
  - id: basic-barrage-04
    weapon: {fileID: 11400000, guid: d6668f2d4fd74a42ba397da914fc94f3, type: 2}
    description: "지정 위치가 1초 뒤 폭발하고 파편이 튑니다. 쿨타임 3초."
  - id: basic-barrage-05
    weapon: {fileID: 11400000, guid: fce757dca8014d9d9a7c53783055e252, type: 2}
    description: "펄스를 발사해 주변 적을 밀어내고 느리게 합니다. 범위 3, 쿨타임 2초."
  - id: basic-barrage-06
    weapon: {fileID: 11400000, guid: e7a01bda95444dcb8b10e1ba0e435226, type: 2}
    description: "이동 속도가 빨라지고 보호막 3과 회전 가시를 얻으며 적에게 부딪히면 피해를 입힙니다. 보호막 소진 또는 시간 종료 시 해제됩니다. 쿨타임 10초."
  - id: basic-barrage-07
    weapon: {fileID: 11400000, guid: 8cc1524f12eb4f9d866688222a076809, type: 2}
    description: "벽에서 반사되는 탄환입니다. 수명 3초, 탄속 15, 쿨타임 1.2초."
  - id: basic-barrage-08
    weapon: {fileID: 11400000, guid: 9ebdcc554267445f9d495b61e97b908f, type: 2}
    description: "플레이어 주변을 공전하는 오브가 접촉한 적을 공격합니다. 수명 5초, 쿨타임 10초."
  - id: meteor-dive
    weapon: {fileID: 11400000, guid: 89a15340c27a436e9bc29670acbd9a0e, type: 2}
    description: "사용 시 전장에서 벗어나고 다시 클릭하거나 2초가 지날 시 마우스 위치로 낙하합니다. 폭발과 함께 파편이 튑니다. 쿨타임 10초."
  - id: octo-shot
    weapon: {fileID: 11400000, guid: e16de90357044eb3956205144ac80a53, type: 2}
    description: "주변 8방향에 탄환을 동시에 발사합니다. 탄속 6, 수명 0.8초, 쿨타임 1.4초."
  - id: boomerang
    weapon: {fileID: 11400000, guid: 0cbb3444a42c4e7c8771227f8e48d25c, type: 2}
    description: "다시 돌아오는 부메랑을 발사합니다. 부메랑을 받을 시 쿨타임이 2초 감소합니다. 쿨타임 8초."
  - id: prism-shot
    weapon: {fileID: 11400000, guid: 8f1b991bf16b4e8d9076c533e6588f0a, type: 2}
    description: "7발의 각기 다른 탄환을 발사합니다. 쿨타임 5초."
  - id: four-axis
    weapon: {fileID: 11400000, guid: 034d54eef0b547a58155a4a78a08477b, type: 2}
    description: "4개의 오브가 4단 공전합니다. 수명 5초. 쿨타임 10초."
  - id: solar-system
    weapon: {fileID: 11400000, guid: eeb9cdacca1a426a8e00cc1962817ee9, type: 2}
    description: "이동 불가 상태가 되며 태양계를 소환합니다. 방어막 3개를 얻으며 방어막 소진 또는 5초 후 종료됩니다. 쿨타임 15초."
  - id: mine
    weapon: {fileID: 11400000, guid: a7c6d9e04683456d83d89ab5a48fcf31, type: 2}
    description: "발밑에 지뢰를 설치합니다. 상대가 밟거나 20초가 지나면 폭발하며, 공격을 3번 맞아도 폭발합니다. Electric Pulse로 밀 수 있습니다. 쿨타임 4초."
  - id: firefly-convergence
    weapon: {fileID: 11400000, guid: 27969cba708315842b8e414bc092ff3a, type: 2}
    description: '화면 밖에서 반딧불이 9마리가 일렁이며 자신을 향해 날아와 닿으면 흡수됩니다. 이동 경로의 적에게 피해를 입힙니다. 쿨타임 8.5초.'
  - id: twin-satellites
    weapon: {fileID: 11400000, guid: bba12fb70988dae4791bc6e57e5e6a71, type: 2}
    description: '지정 위치에 서로 마주 보는 두 위성을 소환합니다. 일정한 속도로 원을 그리며 각각 부채꼴 탄막을 6번 발사합니다. 쿨타임 8초.'
  - id: blossom-burst
    weapon: {fileID: 11400000, guid: 05665ce81db917240af579910c6e94b7, type: 2}
    description: '꽃봉오리 3개를 발사합니다. 봉오리는 서서히 멈춘 뒤 피어나며 각각 8방향으로 꽃잎 탄환을 퍼뜨립니다. 쿨타임 5초.'
  - id: constellation-ignition
    weapon: {fileID: 11400000, guid: 919a329bcc5d326459679ce2282b13cb, type: 2}
    description: '총구에서 빛이 출발해 바다뱀자리, 에리다누스자리, 용자리 중 하나를 순서대로 그립니다. 바로 다음 구간만 예고하며, 완성된 형상의 외곽선도 피해를 입힌 뒤 별빛과 함께 사라집니다. 쿨타임 6초.'
